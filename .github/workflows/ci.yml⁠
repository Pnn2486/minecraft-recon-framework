name: CI & Protocol Framing Verification

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]

permissions:
  contents: read

jobs:
  verify:
    name: Python ${{ matrix.python-version }} ({{ matrix.os }})
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest]
        python-version: ["3.9", "3.10", "3.11", "3.12"]

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}

      - name: Verify bytecode compilation (strict syntax check)
        run: |
          python3 -m py_compile \
            src/mcrecon/*.py \
            src/mcrecon/utils/*.py \
            src/mcrecon/protocols/*.py \
            scripts/run_recon.py \
            tools/packet_inspector.py

      - name: Execute automated unit test suite
        env:
          PYTHONPATH: src
        run: python3 -m unittest discover -s tests -v

      - name: Execute wire-frame inspector self-check
        env:
          PYTHONPATH: src
        run: python3 tools/packet_inspector.py --self-test
