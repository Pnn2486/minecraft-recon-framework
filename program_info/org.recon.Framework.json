{
  "app_id": "org.recon.Framework",
  "name": "minecraft-recon-framework",
  "package": "recon",
  "version": "1.1.0",
  "repository": "https://github.com/Pnn2486/minecraft-recon-framework",
  "license": "LicenseRef-Authorized-Use",
  "python_requires": ">=3.10",
  "dependencies": [],
  "protocols": {
    "server_list_ping": {
      "module": "recon.protocols.ping",
      "transport": "TCP",
      "default_port": 25565,
      "handshake_next_state": 1,
      "packet_ids": {
        "handshake": "0x00",
        "status_request": "0x00",
        "latency_ping": "0x01"
      }
    },
    "gamespy4_query": {
      "module": "recon.protocols.query",
      "transport": "UDP",
      "default_port": 25565,
      "magic_header": "0xFEFD",
      "session_mask": "0x0F0F0F0F",
      "packet_types": {
        "handshake_challenge": "0x09",
        "stat_request": "0x00"
      },
      "server_property_prerequisite": "enable-query=true"
    },
    "source_rcon": {
      "module": "recon.protocols.rcon",
      "transport": "TCP",
      "default_port": 25575,
      "byte_order": "little-endian (<i)",
      "packet_types": {
        "auth": 3,
        "exec_command": 2,
        "response_value": 0
      },
      "server_property_prerequisite": "enable-rcon=true"
    },
    "headless_ghost": {
      "module": "recon.protocols.ghost",
      "transport": "TCP",
      "default_port": 25565,
      "handshake_next_state": 2,
      "compression": "zlib (RFC 1950)",
      "default_protocol_version": "auto",
      "version_detection": "status ping on the same host and port",
      "supported_protocol_versions": [47, 107, 109, 110, 210, 315, 316, 335, 338, 340, 393, 401, 404, 477, 480, 490, 498, 573, 575, 578, 735, 736, 751, 753, 754, 755, 756, 757, 758, 759, 760, 761, 762, 763, 764, 765, 766, 767, 768, 769, 770, 771, 772, 773, 774, 775],
      "server_property_prerequisite": "online-mode=false"
    }
  }
}
